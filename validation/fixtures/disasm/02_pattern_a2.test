# Pattern A2 — single-segment FQN dispatch (`::ns method args`).
# Walker captures both the FQN and the method-name literal.
::ns method arg
::Foo bar
---
  pattern_a2        cmd=1 src_start=127 src_end=141 fqn=::ns method=method arg_count=3
  pattern_a2        cmd=2 src_start=143 src_end=151 fqn=::Foo method=bar arg_count=2
